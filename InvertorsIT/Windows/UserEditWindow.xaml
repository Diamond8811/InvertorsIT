<Window x:Class="InvertorsIT.Windows.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvertorsIT.Windows"
        mc:Ignorable="d"
        Title="UserEditWindow" Height="500" Width="400">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Логин:" Margin="0,5"/>
        <TextBox x:Name="txtUsername" Grid.Row="1" Height="35" Margin="0,0,0,10"/>

        <TextBlock Text="Пароль:" Grid.Row="2" Margin="0,5"/>
        <PasswordBox x:Name="txtPassword" Grid.Row="3" Height="35" Margin="0,0,0,10"/>

        <TextBlock Text="ФИО:" Grid.Row="4" Margin="0,5"/>
        <TextBox x:Name="txtFullName" Grid.Row="5" Height="35" Margin="0,0,0,10"/>

        <TextBlock Text="Email:" Grid.Row="6" Margin="0,5"/>
        <TextBox x:Name="txtEmail" Grid.Row="7" Height="35" Margin="0,0,0,10"/>

        <TextBlock Text="Роль:" Grid.Row="8" Margin="0,5"/>
        <ComboBox x:Name="cboRole" Grid.Row="9" Height="35" Margin="0,0,0,10" 
                  DisplayMemberPath="RoleName" SelectedValuePath="RoleID"/>

        <CheckBox x:Name="chkActive" Grid.Row="10" Content="Активен" Margin="0,10"/>

        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnSave" Content="Сохранить" Width="100" Height="35" 
                    Click="btnSave_Click" Background="Green" Foreground="White" Margin="0,0,10,0"/>
            <Button x:Name="btnCancel" Content="Отмена" Width="100" Height="35" 
                    Click="btnCancel_Click" Background="Red" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>