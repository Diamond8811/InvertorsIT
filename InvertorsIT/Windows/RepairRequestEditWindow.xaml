<Window x:Class="InvertorsIT.Windows.RepairRequestEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvertorsIT.Windows"
        mc:Ignorable="d"
        Title="RepairRequestEditWindow" Height="600" Width="500">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Оборудование:" Margin="0,5" FontWeight="Bold"/>
        <ComboBox x:Name="cboEquipment" Grid.Row="1" Height="35" Margin="0,0,0,10" 
                  DisplayMemberPath="Model" SelectedValuePath="EquipmentID"/>

        <TextBlock Text="Заявитель:" Grid.Row="2" Margin="0,5" FontWeight="Bold"/>
        <ComboBox x:Name="cboRequester" Grid.Row="3" Height="35" Margin="0,0,0,10" 
                  DisplayMemberPath="FullName" SelectedValuePath="UserID"/>

        <TextBlock Text="Описание проблемы:" Grid.Row="4" Margin="0,5" FontWeight="Bold"/>
        <TextBox x:Name="txtIssueDescription" Grid.Row="5" Height="80" TextWrapping="Wrap" 
                 Margin="0,0,0,10" AcceptsReturn="True"/>

        <TextBlock Text="Статус заявки:" Grid.Row="6" Margin="0,5" FontWeight="Bold"/>
        <ComboBox x:Name="cboRequestStatus" Grid.Row="7" Height="35" Margin="0,0,0,10" 
                  DisplayMemberPath="StatusName" SelectedValuePath="RequestStatusID"/>

        <TextBlock Text="Примечания по решению:" Grid.Row="8" Margin="0,5" FontWeight="Bold"/>
        <TextBox x:Name="txtResolutionNotes" Grid.Row="9" Height="60" TextWrapping="Wrap" 
                 Margin="0,0,0,10" AcceptsReturn="True"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnSave" Content="Сохранить" Width="100" Height="35" 
                    Click="btnSave_Click" Background="Green" Foreground="White" Margin="0,0,10,0"/>
            <Button x:Name="btnCancel" Content="Отмена" Width="100" Height="35" 
                    Click="btnCancel_Click" Background="Red" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
