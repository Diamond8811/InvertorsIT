<Window x:Class="InvertorsIT.Windows.EquipmentEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvertorsIT.Windows"
        mc:Ignorable="d" Height="720" Width="450">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Серийный номер:" Margin="0,5"/>
        <TextBox x:Name="txtSerialNumber" Grid.Row="1" Height="35" Margin="0,0,0,10"/>

        <TextBlock Text="Модель:" Grid.Row="2" Margin="0,5"/>
        <TextBox x:Name="txtModel" Grid.Row="3" Height="35" Margin="0,0,0,10"/>

        <TextBlock Text="Производитель:" Grid.Row="4" Margin="0,5"/>
        <TextBox x:Name="txtManufacturer" Grid.Row="5" Height="35" Margin="0,0,0,10"/>

        <TextBlock Text="Тип оборудования:" Grid.Row="6" Margin="0,5"/>
        <ComboBox x:Name="cboType" Grid.Row="7" Height="35" Margin="0,0,0,10" 
                  DisplayMemberPath="TypeName" SelectedValuePath="TypeID"/>

        <TextBlock Text="Статус:" Grid.Row="8" Margin="0,5"/>
        <ComboBox x:Name="cboStatus" Grid.Row="9" Height="35" Margin="0,0,0,10" 
                  DisplayMemberPath="StatusName" SelectedValuePath="StatusID"/>

        <TextBlock Text="Ответственный пользователь:" Grid.Row="10" Margin="0,5"/>
        <ComboBox x:Name="cboUser" Grid.Row="11" Height="35" Margin="0,0,0,10" 
                  DisplayMemberPath="FullName" SelectedValuePath="UserID"/>

        <TextBlock Text="Дата покупки:" Grid.Row="12" Margin="0,5"/>
        <DatePicker x:Name="dpPurchaseDate" Grid.Row="13" Height="35" Margin="0,0,0,10"/>

        <TextBlock Text="Цена покупки:" Grid.Row="14" Margin="0,5"/>
        <TextBox x:Name="txtPurchasePrice" Grid.Row="15" Height="35" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="16" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnSave" Content="Сохранить" Width="100" Height="35" 
                    Click="btnSave_Click" Background="#2ECC71" Foreground="White" Margin="0,0,10,0"/>
            <Button x:Name="btnCancel" Content="Отмена" Width="100" Height="35" 
                    Click="btnCancel_Click" Background="#E74C3C" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
