<Window x:Class="InvertorsIT.Windows.ProcessRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvertorsIT.Windows"
        mc:Ignorable="d"
        Title="ProcessRequestWindow" Height="500" Width="500">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Оборудование:" FontWeight="Bold"/>
        <TextBlock x:Name="txtEquipment" Grid.Row="1" Margin="0,0,0,10"/>
        <TextBlock Text="Описание проблемы:" FontWeight="Bold" Grid.Row="2"/>
        <TextBox x:Name="txtDescription" Grid.Row="3" Height="80" TextWrapping="Wrap" IsReadOnly="True" Margin="0,0,0,10"/>
        <TextBlock Text="Решение / Примечания:" FontWeight="Bold" Grid.Row="4"/>
        <TextBox x:Name="txtResolution" Grid.Row="5" Height="80" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBlock Text="Новый статус:" Grid.Row="6" Margin="0,5"/>
        <ComboBox x:Name="cboStatus" Grid.Row="7" Height="35" Margin="0,0,0,10" DisplayMemberPath="StatusName" SelectedValuePath="RequestStatusID"/>
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnSave" Content="Сохранить" Width="100" Height="35" Click="btnSave_Click" Background="Green" Foreground="White" Margin="0,0,10,0"/>
            <Button x:Name="btnCancel" Content="Отмена" Width="100" Height="35" Click="btnCancel_Click" Background="Red" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>