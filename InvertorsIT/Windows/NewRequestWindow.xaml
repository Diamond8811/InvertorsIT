<Window x:Class="InvertorsIT.Windows.NewRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvertorsIT.Windows"
        mc:Ignorable="d"
        Height="350" Width="450">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Оборудование:" FontWeight="Bold"/>
        <ComboBox x:Name="cboEquipment" Grid.Row="1" Height="35" Margin="0,0,0,10" DisplayMemberPath="Model" SelectedValuePath="EquipmentID"/>
        <TextBlock Text="Описание проблемы:" FontWeight="Bold" Grid.Row="2"/>
        <TextBox x:Name="txtIssue" Grid.Row="3" Height="100" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnSend" Content="Отправить" Width="100" Height="35" Click="btnSend_Click" Background="Green" Foreground="White" Margin="0,0,10,0"/>
            <Button x:Name="btnCancel" Content="Отмена" Width="100" Height="35" Click="btnCancel_Click" Background="Red" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>

