<Page x:Class="InvertorsIT.Pages.AdminDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:InvertorsIT.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminDashboardPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Violet" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnUsers" Content="Пользователи" Width="120" Height="35" 
                        Margin="5" Click="btnUsers_Click" Background="#3498DB" Foreground="White"/>
                <Button x:Name="btnEquipment" Content="Оборудование" Width="120" Height="35" 
                        Margin="5" Click="btnEquipment_Click" Background="#3498DB" Foreground="White"/>
                <Button x:Name="btnRequests" Content="Заявки" Width="120" Height="35" 
                        Margin="5" Click="btnRequests_Click" Background="#3498DB" Foreground="White"/>
            </StackPanel>
        </Border>

        <Frame x:Name="ContentFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Page>