<Page x:Class="InvertorsIT.Pages.EquipmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:InvertorsIT.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EquipmentPage">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="btnAdd" Content="Добавить" Width="100" Height="35" 
                    Click="btnAdd_Click" Background="Green" Foreground="White" Margin="0,0,10,0"/>
            <Button x:Name="btnEdit" Content="Редактировать" Width="100" Height="35" 
                    Click="btnEdit_Click" Background="Blue" Foreground="White" Margin="0,0,10,0"/>
            <Button x:Name="btnDelete" Content="Удалить" Width="100" Height="35" 
                    Click="btnDelete_Click" Background="Red" Foreground="White" Margin="0,0,10,0"/>
            <Button x:Name="btnRefresh" Content="Обновить" Width="100" Height="35" 
                    Click="btnRefresh_Click" Background="BlueViolet" Foreground="White"/>
        </StackPanel>

        <DataGrid x:Name="dgEquipment" Grid.Row="1" AutoGenerateColumns="False" 
                  IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding EquipmentID}" Width="50"/>
                <DataGridTextColumn Header="Серийный номер" Binding="{Binding SerialNumber}" Width="120"/>
                <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="120"/>
                <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="100"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding EquipmentTypes.TypeName}" Width="100"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding EquipmentStatuses.StatusName}" Width="100"/>
                <DataGridTextColumn Header="Ответственный" Binding="{Binding Users.FullName}" Width="120"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding PurchasePrice}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Page>
