<Page x:Class="InvertorsIT.Pages.EmployeePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:InvertorsIT.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EmployeePage">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="dgMyEquipment" Grid.Row="2" Height="200" AutoGenerateColumns="False" 
                  IsReadOnly="True" SelectionMode="Single" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Серийный номер" Binding="{Binding SerialNumber}" Width="120"/>
                <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="150"/>
                <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="100"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding EquipmentTypes.TypeName}" Width="100"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding EquipmentStatuses.StatusName}" Width="100"/>
                <DataGridTextColumn Header="Дата покупки" Binding="{Binding PurchaseDate, StringFormat=dd.MM.yyyy}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="btnNewRequest" Content="Новая заявка на ремонт" Width="200" Height="35" 
                    Click="btnNewRequest_Click" Background="Green" Foreground="White" Margin="0,0,10,0"/>
            <Button x:Name="btnRefreshEquipment" Content="Обновить оборудование" Width="150" Height="35" 
                    Click="btnRefreshEquipment_Click" Background="Blue" Foreground="White"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="Мои заявки на ремонт" FontSize="16" FontWeight="Bold" Margin="0,10,0,5"/>
        <DataGrid x:Name="dgMyRequests" Grid.Row="5" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding RequestID}" Width="50"/>
                <DataGridTextColumn Header="Оборудование" Binding="{Binding Equipment.Model}" Width="150"/>
                <DataGridTextColumn Header="Описание проблемы" Binding="{Binding IssueDescription}" Width="200"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding RequestStatuses.StatusName}" Width="100"/>
                <DataGridTextColumn Header="Дата создания" Binding="{Binding RequestDate, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                <DataGridTextColumn Header="Решение" Binding="{Binding ResolutionNotes}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnRefreshRequests" Content="Обновить заявки" Width="130" Height="35" 
                    Click="btnRefreshRequests_Click" Background="BlueViolet" Foreground="White"/>
        </StackPanel>
    </Grid>
</Page>