<Page x:Class="InvertorsIT.Pages.RepairRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:InvertorsIT.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RepairRequestsPage">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="btnAdd" Content="Добавить заявку" Width="120" Height="35" 
                    Click="btnAdd_Click" Background="Green" Foreground="White" Margin="0,0,10,0"/>
            <Button x:Name="btnEdit" Content="Редактировать" Width="100" Height="35" 
                    Click="btnEdit_Click" Background="Blue" Foreground="White" Margin="0,0,10,0"/>
            <Button x:Name="btnDelete" Content="Удалить" Width="100" Height="35" 
                    Click="btnDelete_Click" Background="Red" Foreground="White" Margin="0,0,10,0"/>
            <Button x:Name="btnRefresh" Content="Обновить" Width="100" Height="35" 
                    Click="btnRefresh_Click" Background="BlueViolet" Foreground="White"/>
        </StackPanel>

        <DataGrid x:Name="dgRequests" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding RequestID}" Width="50"/>
                <DataGridTextColumn Header="Оборудование" Binding="{Binding Equipment.Model}" Width="120"/>
                <DataGridTextColumn Header="Заявитель" Binding="{Binding Users.FullName}" Width="120"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding IssueDescription}" Width="200"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding RequestStatuses.StatusName}" Width="100"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding RequestDate}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Page>