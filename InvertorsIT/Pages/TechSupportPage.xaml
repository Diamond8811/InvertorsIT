<Page x:Class="InvertorsIT.Pages.TechSupportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:InvertorsIT.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TechSupportPage">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Заявки на ремонт" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
        <DataGrid x:Name="dgRequests" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding RequestID}" Width="50"/>
                <DataGridTextColumn Header="Оборудование" Binding="{Binding Equipment.Model}" Width="150"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding IssueDescription}" Width="200"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding RequestStatuses.StatusName}" Width="100"/>
                <DataGridTextColumn Header="Заявитель" Binding="{Binding Users.FullName}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnProcess" Content="Обработать" Width="120" Height="35" Click="btnProcess_Click" Background="CornflowerBlue" Foreground="White" Margin="0,0,10,0"/>
            <Button x:Name="btnRefresh" Content="Обновить" Width="100" Height="35" Click="btnRefresh_Click" Background="BlueViolet" Foreground="White"/>
        </StackPanel>
    </Grid>
</Page>
